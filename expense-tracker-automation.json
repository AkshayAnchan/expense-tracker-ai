    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Today's date\nconst today = new Date().toLocaleDateString('en-CA', {\n  timeZone: 'Asia/Kolkata'\n});\n\nlet total = 0;\nlet message = \"📅 Today's Expenses\\n\\n\";\nlet count = 0;\n\nfor (const item of items) {\n\n    const expense = item.json;\n\n    // Example:\n    // createdAt = 2026-08-18T06:20:02.270Z\n    // expenseDate = 2026-08-18\n    const expenseDate = expense.createdAt.split('T')[0];\n\n    // Only take today's expenses\n    if (expenseDate === today) {\n\n        count++;\n\n        const amount = Number(expense.amount || 0);\n        const category = expense.category || \"Other\";\n        const description = expense.description || \"\";\n\n        total += amount;\n\n        message += `${count}. ₹${amount} - ${category}`;\n\n        if (description) {\n            message += ` - ${description}`;\n        }\n\n        message += \"\\n\";\n    }\n}\n\nif (count === 0) {\n    message = \"📅 No expenses found for today.\";\n} else {\n    message += `\\n💰 Today's Total: ₹${total.toFixed(2)}`;\n}\n\nreturn [\n    {\n        json: {\n            message: message\n        }\n    }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
