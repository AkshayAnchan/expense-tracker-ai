    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst now = new Date();\n\nconst currentMonth = now.toLocaleString('en-US', {\n  timeZone: 'Asia/Kolkata',\n  month: '2-digit'\n});\n\nconst currentYear = now.toLocaleString('en-US', {\n  timeZone: 'Asia/Kolkata',\n  year: 'numeric'\n});\n\nlet total = 0;\nlet count = 0;\n\nlet message = \"📅 This Month's Expenses\\n\\n\";\n\nfor (const item of items) {\n  const expense = item.json;\n\n  const expenseDate = new Date(expense.createdAt);\n\n  const expenseMonth = expenseDate.toLocaleString('en-US', {\n    timeZone: 'Asia/Kolkata',\n    month: '2-digit'\n  });\n\n  const expenseYear = expenseDate.toLocaleString('en-US', {\n    timeZone: 'Asia/Kolkata',\n    year: 'numeric'\n  });\n\n  if (\n    expenseMonth === currentMonth &&\n    expenseYear === currentYear\n  ) {\n    count++;\n\n    const amount = Number(expense.amount || 0);\n    const category = expense.category || \"Other\";\n    const description = expense.description || \"\";\n\n    total += amount;\n\n    message += `${count}. ₹${amount} - ${category}`;\n\n    if (description) {\n      message += ` - ${description}`;\n    }\n\n    message += \"\\n\";\n  }\n}\n\nif (count === 0) {\n  message = \"📅 No expenses found for this month.\";\n} else {\n  message += `\\n💰 Monthly Total: ₹${total.toFixed(2)}`;\n  message += `\\n📊 Transactions: ${count}`;\n}\n\nreturn [\n  {\n    json: {\n      message\n    }\n  }\n];"
      },
